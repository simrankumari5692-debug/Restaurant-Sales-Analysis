print("3. Average Order Sale         : ₹", round(average_sales, 2))
print("4. Best Selling Item          :", best_selling_item)
print("5. Best Performing Category   :", best_category)
print("6. Most Used Payment Method   :", most_used_payment)
print("7. Best Sales Day             :", best_day)
print("8. Highest Sales on Best Day  : ₹", best_day_sales)

print("================================================")
